# AStyle configuration for the PropaneScale workspace
# Use K&R style: opening brace on the same line as control statements/functions
--style=kr
# Indent with spaces and set indentation width to 2 (matches project style)
--indent=spaces=2
# Add spaces around operators (e.g., a + b)
--pad-oper
# Add a space after commas in lists and function arguments
--pad-comma
# Align the pointer `*` next to the type (e.g., int* p)
--align-pointer=type
# Align the reference `&` next to the type (e.g., int& r)
--align-reference=type
# Break blocks to place compound statements on separate lines for clarity
--break-blocks
# Split chained else-if statements onto separate lines for readability
--break-elseifs
# Increase max line length to avoid splitting long inline initializers and comments
--max-code-length=150
# Do not create backup files with additional suffixes
--suffix=none
